# ===== Сервер =====
NODE_ENV=production
PORT=8080
PUBLIC_URL=https://api.kambarshop.ru
DATABASE_URL=postgres://kbs:пароль@localhost:5432/kbs
# Случайная строка от 32 символов: openssl rand -hex 32
JWT_SECRET=
CORS_ORIGINS=capacitor://localhost,https://localhost,http://localhost

# ===== 1С =====
# mock: демо-данные; odata: стандартный интерфейс OData; http: HTTP-сервис по контракту docs/1c-http-service.md
ONEC_MODE=odata
# Для OData: https://сервер/база/odata/standard.odata  Для HTTP-сервиса: https://сервер/база/hs/kbs
ONEC_BASE_URL=
ONEC_USER=
ONEC_PASSWORD=
ONEC_TIMEOUT_MS=20000
ONEC_SYNC_INTERVAL_MIN=10
ONEC_WRITE_ORDERS=true
ONEC_ODATA_MAPPING=config/onec-odata.json
CATALOG_CONFIG=config/catalog.json
# Пусто: фото раздаёт этот сервер из папки media
MEDIA_BASE_URL=

# ===== ЮKassa =====
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_SEND_RECEIPT=false
YOOKASSA_VAT_CODE=1

# ===== SMS (sms.ru) =====
SMS_PROVIDER=smsru
SMSRU_API_ID=
SMS_SENDER=
# Номера для проверки App Store и Google Play, код всегда 0000
REVIEW_PHONES=+79990000000

# ===== Внутреннее приложение компании =====
INTERNAL_API_KEY=
INTERNAL_WEBHOOK_URL=
INTERNAL_WEBHOOK_SECRET=

# ===== Push (Firebase, сервисный аккаунт) =====
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Ключ одной строкой, переводы строк как \n
FCM_PRIVATE_KEY=

# ===== Магазин =====
FREE_DELIVERY_FROM_RUB=2500
DELIVERY_FEE_RUB=250
DELIVERY_ETA=15 минут
PICKUP_POINTS=[{"id":"shop","title":"Магазин","address":"пер. имени Заварицкого А.Н., 11, строение 8","hours":"Пн–Пт 10:00–18:00, Сб 11:00–16:00, Вс выходной"},{"id":"coffee","title":"Чайная лавка и кофейня","address":"ул. Топоркова, 8, ТЦ «Армат Центр», модуль 1, линия 3","hours":"Пн–Вс 9:00–20:00"}]
SUPPORT_PHONE=+7 900 689-18-24
WORKING_HOURS=Пн–Пт 10:00–18:00, Сб 11:00–16:00, Вс выходной
LEGAL_OPERATOR=ИП ..., ИНН ..., ОГРНИП ...
LEGAL_EMAIL=
